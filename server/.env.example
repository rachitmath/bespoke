# PostgreSQL Database Connection Strings (Supabase / Render / Local)
# 1. DATABASE_URL: Transaction Pooler (Port 6543) with ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# 2. DIRECT_URL: Direct / Session connection (Port 5432) used by Prisma for schema sync/migrations
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Port to run the NestJS server on
PORT=3001

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Optional: Gemini Model
GEMINI_MODEL=gemini-2.5-flash
