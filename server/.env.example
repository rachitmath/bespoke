# PostgreSQL Database Connection String (Supabase / Render / Local)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (Required)
# Get a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port to run the NestJS server on (Default: 3001)
PORT=3001

# Allowed frontend origin for CORS (Default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Optional: Gemini Model (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
